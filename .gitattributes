# Normalize line endings to LF on commit (kills the constant CRLF warnings on
# Windows and keeps diffs clean across machines / CI / agents).
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.glb binary
*.gltf binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles: text, but don't show in diffs by default (noise).
package-lock.json -diff linguist-generated
