    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-konva": "^19.2.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
