    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-table": "^9.1.2",
    "@tensorflow-models/deeplab": "^0.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "fuse.js": "^7.5.0",
