# AI provider for plan presentation. The app works fully with the default mock provider —
# no key required. Supported: mock, claude, deepseek, qwen, doubao, glm, siliconflow, ollama, none.
ENABLE_AI=false
AI_PROVIDER=mock

# Required when AI_PROVIDER=claude. Also enables opt-in yard-photo analysis (Claude vision).
ANTHROPIC_API_KEY=
# Optional cheap presentation providers. Missing keys fall back to mock.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
GLM_API_KEY=
SILICONFLOW_API_KEY=
# OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=llama3.1

# Optional live data. Disabled by default; deterministic planning never waits on it.
NEXT_PUBLIC_ENABLE_LIVE_DATA=false
LIVE_DATA_PROVIDER=mock
ENABLE_SCRAPING=false

# Optional AI image render ("imagined view"). OFF unless IMAGE_API_KEY is set — the app and the
# "See your yard" board work fully without it. Provider-agnostic, OpenAI-images-compatible.
IMAGE_API_KEY=
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1

# Optional 3D/AR model for "View in your space". Defaults to a representative model; point this at
# a real .glb (e.g. a hosted plant/bed model) to replace it. Public — exposed to the browser.
# NEXT_PUBLIC_AR_MODEL_URL=
