# AI provider for plan presentation. The app works fully with the default mock provider —
# no key required. Supported: mock, claude, deepseek, qwen, doubao, glm, siliconflow, ollama, none.
ENABLE_AI=false
AI_PROVIDER=mock

# Required when AI_PROVIDER=claude. Also enables opt-in yard-photo analysis (Claude vision).
ANTHROPIC_API_KEY=
# Optional cheap presentation providers. Missing keys fall back to mock.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
GLM_API_KEY=
SILICONFLOW_API_KEY=
# OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=llama3.1

# Optional live data ("Live Data Layer" — see docs/LIVE_DATA_LAYER.md). The layer ENRICHES the
# deterministic plan (price estimates, planting timing, plant care, invasive caution); it never
# overrides facts and the plan never waits on it. Works fully with mock providers (no keys).
NEXT_PUBLIC_ENABLE_LIVE_DATA=false
# Which real provider family to activate. "mock" (default) keeps everything key-free.
# Recognized real values: serpapi (retailer price), perenual (plant facts), open-meteo (weather), gbif (invasive).
LIVE_DATA_PROVIDER=mock
ENABLE_SCRAPING=false
# Optional real-provider keys (deferred adapters; absent → mock estimates). Server-only, never client.
# SERPAPI_KEY=
# PERENUAL_API_KEY=

# --- Free/Open Data Mode (see docs/FREE_DATA_MODE.md) ---
# Free Data Mode is the SAFE DEFAULT whenever live data is off (NEXT_PUBLIC_ENABLE_LIVE_DATA=false):
# curated catalog + generated retailer SEARCH links + seasonal-rule weather. It needs NO keys and
# never claims live stock or final prices. These flags are documented defaults — a fresh checkout
# with none of them set runs fully in free mode.
FREE_DATA_MODE_ENABLED=true
RETAILER_SEARCH_PROVIDER=search_links
WEATHER_PROVIDER=seasonal_rules
PLANT_DATA_PROVIDER=curated
IMAGE_DATA_PROVIDER=curated
TUTORIAL_PROVIDER=curated
# Future paid upgrades (optional; commented — none are required to run):
# SERPAPI_KEY=
# PERENUAL_API_KEY=
# YOUTUBE_API_KEY=
# Open-Meteo: with LIVE_DATA_PROVIDER=open-meteo and NO key below, weather uses the FREE tier,
# which is CC-BY 4.0 and NON-COMMERCIAL only. Bloomprint bills via Stripe, so production must set
# a paid key here — that alone routes requests to customer-api.open-meteo.com (commercial tier).
# OPEN_METEO_API_KEY=

# Optional AI image render ("imagined view"). OFF unless IMAGE_API_KEY is set — the app and the
# "See your yard" board work fully without it. Provider-agnostic, OpenAI-images-compatible.
IMAGE_API_KEY=
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# Optional structure-preserving "concept restyle" of the user's photo. Only takes effect when
# IMAGE_API_URL points at a ControlNet-depth-capable endpoint (it does the depth preprocessing).
# Decorative only — never feeds the plan; layout/scale are approximate. Leave unset for text-only.
# IMAGE_CONTROLNET=1

# Optional photo vision ("Read Photo" → sun + observations). OFF unless configured.
# Path A: Claude (set AI_PROVIDER=claude + ANTHROPIC_API_KEY above).
# Path B: any OpenAI-compatible vision model via VISION_API_KEY (cheap Chinese, e.g. SiliconFlow Qwen-VL).
# VISION_API_KEY=
# VISION_API_URL=https://api.siliconflow.com/v1/chat/completions
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Optional 3D/AR model for "View in your space". Defaults to a representative model; point this at
# a real .glb (e.g. a hosted plant/bed model) to replace it. Public — exposed to the browser.
# NEXT_PUBLIC_AR_MODEL_URL=

# Optional cloud sync + auth (Supabase). The app works fully without these — saved plans, profile,
# and photos stay on-device (localStorage) and the deterministic plan never waits on the cloud.
# Set these to enable accounts (Google / email / phone) + cross-device sync. See docs/SUPABASE_MIGRATION.md.
# Project ref: qojtvpkzwufqxzpnatha
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe to expose to the browser; RLS protects every row.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client. Optional — enables the AI prompt cache + billing writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (local only; put real values in .env.local, never commit) ---
# Personal access token from https://supabase.com/dashboard/account/tokens (for `supabase login`).
SUPABASE_ACCESS_TOKEN=
# Google OAuth client (Google Cloud Console). Used by supabase/config.toml [auth.external.google].
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Phone (SMS) auth is wired but OFF until you set an SMS provider (Twilio etc.) in Supabase and
# flip this on. Leave false to hide the phone option.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false

# Optional payments (Stripe Billing). The app stays free/local without these — paid tiers only add
# cloud scale, exports, staff mode, and more AI. Server-only secrets; never put them in client code.
# Run supabase/migrations/0001_billing.sql first, then set:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
# Used for Checkout success/cancel + portal return URLs.
NEXT_PUBLIC_APP_URL=https://bloomprint.vercel.app
