# AI provider for plan presentation. The app works fully with the default mock provider —
# no key required. Set to "claude" to enable the Anthropic adapter.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Optional AI image render ("imagined view"). OFF unless IMAGE_API_KEY is set — the app and the
# "See your yard" board work fully without it. Provider-agnostic, OpenAI-images-compatible.
IMAGE_API_KEY=
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
