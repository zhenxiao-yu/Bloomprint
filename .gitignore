# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# raw USDA PLANTS exports — multi-MB build-time inputs; the small derived
# artifact (src/domain/data/usda-synonyms.generated.json) is committed instead.
/data/usda/*.txt
/data/usda/*.csv

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase (CLI local state — never commit)
supabase/.temp
supabase/.branches
supabase/signing_keys.json

# agent skills (installed via skills.sh — local tooling, not app code)
.agents/

# Claude Code local settings (machine-specific permission allowlist; not shared)
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local visual-review screenshots
/.shots/
